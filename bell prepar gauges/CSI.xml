          <Image Name="csi_to_flag.bmp"/>
       </Case>
	 <Case Value="2">
          <Image Name="csi_from_flag.bmp"/>
       </Case>
    </Select>
  </Element>
  
  <Element>
   <Position X="65" Y="117"/>
    <Image Name="csi_needle_2.bmp">
